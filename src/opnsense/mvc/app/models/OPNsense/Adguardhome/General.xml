<model>
    <mount>//OPNsense/adguardhome/general</mount>
    <description>Adguardhome general configuration</description>
    <version>1.0.0</version>
    <items>
        <enabled type="BooleanField">
            <default>0</default>
            <Required>Y</Required>
        </enabled>
        <bind_hosts type="NetworkField">
            <NetMaskAllowed>N</NetMaskAllowed>
            <AsList>Y</AsList>
            <Required>Y</Required>
            <ValidationMessage>Please enter one or more valid IPv4 or IPv6 addresses.</ValidationMessage>
        </bind_hosts>
        <dns_port type="IntegerField">
            <default>53</default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>65535</MaximumValue>
            <Required>Y</Required>
        </dns_port>
    </items>
</model>
