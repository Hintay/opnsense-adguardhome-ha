<model>
    <mount>//OPNsense/adguardhome/sync</mount>
    <description>AdGuard Home synchronization settings</description>
    <version>1.2.0</version>
    <items>
        <enabled type="BooleanField">
            <default>0</default>
            <Required>Y</Required>
        </enabled>
        <port type="IntegerField">
            <default>9443</default>
            <MinimumValue>1024</MinimumValue>
            <MaximumValue>65535</MaximumValue>
            <Required>Y</Required>
        </port>
        <secret type="TextField">
            <MaximumLength>256</MaximumLength>
            <AllowNewlines>N</AllowNewlines>
        </secret>
        <peer_fingerprint type="TextField">
            <MaximumLength>95</MaximumLength>
            <AllowSpaces>N</AllowSpaces>
            <AllowNewlines>N</AllowNewlines>
        </peer_fingerprint>
        <api_username type="TextField">
            <MaximumLength>128</MaximumLength>
            <AllowNewlines>N</AllowNewlines>
        </api_username>
        <api_password type="TextField">
            <MaximumLength>256</MaximumLength>
            <AllowNewlines>N</AllowNewlines>
        </api_password>
        <hot_update type="BooleanField">
            <default>1</default>
            <Required>Y</Required>
        </hot_update>
        <defer_while_master type="BooleanField">
            <default>0</default>
            <Required>Y</Required>
        </defer_while_master>
    </items>
</model>
